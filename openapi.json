{"info":{"contact":{"name":"ArchiCheck Platform Engineering","url":"http://localhost"},"description":"REST API for external AI systems, LLM agents, and architectural tools to access, analyze, and benchmark residential plan validation results, statutory Israeli codes, NKBA guidelines, and Space Syntax spatial metrics.","title":"ArchiCheck Architectural Quality & Compliance AI API","version":"1.0.0"},"openapi":"3.1.0","paths":{"/ai/context":{"post":{"operationId":"getAIArchitecturalContext","requestBody":{"content":{"application/json":{"schema":{"properties":{"max_items":{"default":6,"type":"integer"},"project_id":{"type":"string"},"query":{"type":"string"}},"required":["query"],"type":"object"}}},"required":true},"responses":{"200":{"description":"Structured prompt context"}},"summary":"Extract prompt context for an LLM query"}},"/analyze/plan":{"post":{"operationId":"analyzeCustomPlan","requestBody":{"content":{"application/json":{"schema":{"type":"object"}}},"required":true},"responses":{"200":{"description":"Live validation results"}},"summary":"Run live validation on custom apartment JSON"}},"/compare":{"get":{"operationId":"compareProjects","parameters":[{"description":"Comma-separated project IDs (e.g. pines48,kkl10,kitroni37)","in":"query","name":"projects","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Comparative table"}},"summary":"Compare architectural projects side-by-side"}},"/projects":{"get":{"description":"Returns catalog of projects with compliance scores and summary links.","operationId":"listProjects","parameters":[{"description":"Search query for filtering by name or keyword","in":"query","name":"q","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"List of projects"}},"summary":"List all architectural projects"}},"/projects/{project_id}":{"get":{"operationId":"getProjectDetails","parameters":[{"description":"Project ID (e.g.